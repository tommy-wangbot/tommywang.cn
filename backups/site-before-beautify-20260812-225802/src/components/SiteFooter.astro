---
import { SITE } from '../data/site';

interface Props {
  /** 深色页面上页脚已在深色区，去掉重复的上边线 */
  seamless?: boolean;
}
const { seamless = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" style={seamless ? 'border-top: 0;' : undefined}>
  <div class="foot-main">
    <span>© {year} <b>{SITE.name}</b></span>
    <span>来信交流：<a href={`mailto:${SITE.email}`}>{SITE.email}</a></span>
  </div>
  <div class="icp">
    <a href="https://beian.miit.gov.cn" target="_blank" rel="noopener">{SITE.icp}</a>
    <span class="mps">
      <img src="/gongan-beian.png" width="18" height="20" alt="公安备案图标" />
      <a href={SITE.mpsUrl} rel="noreferrer" target="_blank">{SITE.mps}</a>
    </span>
  </div>
</footer>
