---
import { SITE } from '../data/site';

interface Props {
  /** 深色页面上页脚已在深色区，去掉重复的上边线 */
  seamless?: boolean;
}
const { seamless = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer" style={seamless ? 'border-top: 0;' : undefined}>
  <div class="foot-main">
    <span>© {year} 王少怀</span>
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a href="https://beian.miit.gov.cn" target="_blank" rel="noopener">{SITE.icp}</a>
    <a class="mps" href={SITE.mpsUrl} target="_blank" rel="noreferrer">
      <img src="/gongan-beian.png" width="14" height="14" alt="" />
      {SITE.mps}
    </a>
  </div>
</footer>
