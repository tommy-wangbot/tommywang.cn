---
import { SITE } from '../data/site';
interface Props {
  /** 当前所在栏目：method | research | notes | about | undefined */
  active?: 'method' | 'research' | 'notes' | 'about';
}
const { active } = Astro.props;
const keyOf = (href: string) => {
  if (href.startsWith('/method')) return 'method';
  if (href.startsWith('/research')) return 'research';
  return 'notes';
};
---
<!-- 内页导航：站名 + 三个栏目 + 关于我。关于我只是小字链接，不是第四个栏目。 -->
<nav class="nav" aria-label="主导航">
  <div class="nav-inner">
    <a class="nav-brand" href="/">
      <span>{SITE.name}</span>
    </a>
    <div class="nav-doors">
      {
        SITE.doors.map((d) => (
          <a href={d.href} aria-current={active === keyOf(d.href) ? 'page' : undefined}>
            {d.label}
          </a>
        ))
      }
    </div>
    <a class="nav-about" href="/about/" aria-current={active === 'about' ? 'page' : undefined}>关于我</a>
  </div>
</nav>
