---
interface Props {
  /** 笔记：问题 / 假设 / 判断；手稿：成稿 / 在写 / 待改 */
  status: '问题' | '假设' | '判断' | '成稿' | '在写' | '待改' | string;
  /** 已入账本时链向对应卡 */
  cardId?: string;
}
const { status, cardId } = Astro.props;

const LABELS: Record<string, string> = {
  问题: '问题 · 我还没有答案',
  假设: '假设 · 证据尚不充分',
  判断: '判断 · 已入账本',
  成稿: '成稿 · 可以当完整论述读',
  在写: '在写 · 还没定稿',
  待改: '待改 · 已知有问题',
};
const label = LABELS[status] ?? status;

const href = cardId ? `/research/ledger/#card-${cardId}` : undefined;
const Tag = href ? 'a' : 'span';
---

<Tag class="status-tag" data-status={status} href={href}>{label}</Tag>
