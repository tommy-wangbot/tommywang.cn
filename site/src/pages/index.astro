---
import BaseLayout from '../layouts/BaseLayout.astro';
import JudgmentCard from '../components/JudgmentCard.astro';
import { SITE } from '../data/site';
import { recentNotes } from '../lib/notes';

const notes = await recentNotes(5);

const doors = [
  {
    path: '/method/',
    title: '工作方法',
    keys: '方法 / 工具 / 实践',
    desc: '记录我在真实项目中处理材料、建立证据、形成判断和复盘修正的方法。',
  },
  {
    path: '/research/',
    title: '研究与判断',
    keys: '观点 / 研究 / 修正',
    desc: 'AI 把知道和执行的成本压到接近于零之后，人还剩下什么是稀缺的？一本正在公开写作的书，外加一份写明「什么情况算我错了」的记录。',
  },
];
---

<BaseLayout description={SITE.tagline}>
  <header class="home-hero">
    <p class="kicker">{SITE.name}</p>
    <h1 class="display">{SITE.tagline}</h1>
    <p class="home-intro">
      顺着好奇心持续探索、研究和尝试，在复杂世界里寻找真正的问题，形成自己的判断，再让实践和时间不断检验、修正它。
    </p>
  </header>
  <hr class="home-rule" />

  <nav class="home-doors" aria-label="主题栏目">
    {
      doors.map((d) => (
        <a class="home-door" href={d.path}>
          <span class="dpath">{d.path}</span>
          <p class="dname">{d.title}</p>
          <p class="ddesc">{d.desc}</p>
          <p class="dkeys">{d.keys}</p>
        </a>
      ))
    }
  </nav>

  <section class="home-ledger dark" aria-labelledby="home-card-h">
    <div class="inner">
      <p class="kicker" id="home-card-h">一张判断长这样</p>
      <p class="card-note-in">
        我把重要的判断提前写下来：会发生什么、依据是什么、出现什么情况就算我错了。
        后来错了的，也留在原处不删——只在下面追加一条改判记录。
      </p>
      <JudgmentCard id="CS-XINGLAN-01" />
      <p class="card-note-out">
        全部记录 → <a href="/research/ledger/">公开判断记录</a>
      </p>
    </div>
  </section>

  <section class="home-notes" aria-labelledby="home-notes-h">
    <div class="nhead">
      <h2 id="home-notes-h">最近笔记</h2>
      <a href="/notes/">全部笔记</a>
    </div>
    <div class="nlist">
      {
        notes.map((n) => (
          <a class="nitem" href={`/notes/${n.slug}/`}>
            <span class="nd">{n.date}</span>
            <span class="nt">{n.title}</span>
            <span class="status-tag" data-status={n.status}>{n.status}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .home-ledger .card-note-in {
    margin: var(--half) 0 var(--leading);
    font-size: 16px;
    line-height: 1.95;
    color: var(--dim);
    max-width: 38em;
  }
</style>
