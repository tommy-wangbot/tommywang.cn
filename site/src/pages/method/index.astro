---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const judgmentParts = [
  { name: '预测', gloss: '对局势的分析推演', verdict: 'AI 能做，甚至更好。' },
  { name: '权衡', gloss: '在利润与风险、短期与长期之间说"这个更重要"', verdict: '需要立场与取舍，不存在于任何训练数据里。' },
  { name: '担责', gloss: '用位子和声誉为后果买单', verdict: 'AI 没有可被问责的身份——它的所有建议都是"无担保的认知支票"，签名必须由人来签。' },
];

const pains = [
  { no: '01', title: '上百份材料互相矛盾', body: '161 场访谈、223 份一手资料散落各处，靠通读"找感觉"要花数周，且口径对不齐。' },
  { no: '02', title: '判断只存在人脑中', body: '关键结论的来龙去脉压在个别人身上，人一忙一走，项目就断档。' },
  { no: '03', title: '方案会被领导追问', body: '"依据是什么？为什么不选另一个方案？"答不上来，方案可信度当场崩塌。' },
  { no: '04', title: '新材料不断推翻旧前提', body: '三周前的判断建立在已变化的事实上，没人记得这层依赖，只能凭感觉改稿。' },
  { no: '05', title: '经验随交付蒸发', body: '项目结束只剩一份 PPT，踩过的坑、做过的权衡、否掉的备选全部消失。' },
];

const mechanisms = [
  { name: '决策依据账本', points: ['每个重要结论记账入册', '凭证（原始材料）可查', '账目只增不涂改', '半年后仍能还原"当时为什么这么定"'] },
  { name: '证据驱动判断', points: ['无依据，不进报告', '找不到证据的论断强制标注"待验证"', '不允许伪装成事实'] },
  { name: '方案压力测试', points: ['上会之前，系统先扮演最刁钻的领导把方案问一遍', '最坏的问题提前听过、答过、备好弹药'] },
];

const notThese = [
  { what: '聊天机器人', why: '它是嵌入工作流程的生产系统。' },
  { what: 'AI 写作工具', why: '写报告只是最后一道工序。' },
  { what: '网盘或知识库', why: '知识库存名词，它管理活的判断。' },
  { what: '取代顾问和决策者', why: '恰恰相反，它让人专注于机器做不了的裁决。' },
];

const facets = [
  { no: '01', name: '思考的工业化', body: '高水平分析今天仍是手工作坊：过程在专家脑里、质量靠状态、无法检验。本系统把它改造成工厂——有工序，有质检，有台账，有工艺积累。' },
  { no: '02', name: '认知复利系统', body: '大多数软件越用越旧，它越用越值钱：持续学习使用组织的管理原则与决策偏好，三年后成为"只懂这家组织的认知底座"。' },
  { no: '03', name: '三方协同生产', body: 'AI 负责理解（消化材料）与生成（梳理方案），人负责裁决与责任。机器处理噪音与索引，人类负责裁判与背书。' },
  { no: '04', name: '组织的决策账本', body: '钱有账本：每笔有凭证、能审计、不能涂改。比钱更贵的决策，第一次也有了账。' },
  { no: '05', name: '不会离职的数字研究团队', body: '专家的判断过程（不只结论，还有依据、权衡、否掉的备选）结构化留存；新人接手从"泡三个月找感觉"变成"直接读账"。' },
  { no: '06', name: '让答案值得相信', body: '市面上的 AI 帮你更快找到答案；它回答下一个问题：为什么相信这个答案？' },
];

const pipeline = [
  { no: '0', name: '输入 · 原始材料', what: '访谈录音 / 会议纪要 / 报表 / 制度文件 / 领导讲话', out: '原始材料统一入口' },
  { no: '1', name: '原料提纯', what: '杂料变净料：去噪、分类、拆条，每条信息标注来源（哪份文件、哪次访谈、谁说的）', out: '净料待审核清单' },
  { no: '2', name: '人工质检闸门', what: 'AI 只起草，人批准后方可入账：进账本的每个字都有人负责过', out: '人工审核与签字' },
  { no: '3', name: '决策依据账本', what: '追加式记录：旧版本保留、变更留痕，任何时候能还原决策现场', out: '组织的长期记忆' },
  { no: '4', name: '双脑协同', what: '一个 AI 脑 7×24 消化材料，另一个 AI 脑在净料上做高强度推理', out: '理解脑 ＋ 推理脑' },
  { no: '5', name: '证据强制', what: '每个关键结论必须挂上可点回原文的依据，无依据不进报告', out: '证据锚点直达' },
  { no: '6', name: '判断卡', what: '重要判断写成标准卡片：证据、备选假设、置信度、认错条件', out: '结构化判断资产' },
  { no: '7', name: '红队答辩预演', what: '上会前被系统问倒一次，输出"会被问什么"＋ 怎么答 ＋ 依据在哪页', out: '提前备弹药' },
  { no: '8', name: '变更重审', what: '新材料进来，自动列出受影响的旧判断与方案段落', out: '影响清单与提醒' },
  { no: '9', name: '规律沉淀', what: '跨项目提炼风险模式与管理原则，形成持续生长的判断模式库', out: '判断模式库' },
];

const disciplines = [
  { no: '1', name: '无依据，不进报告', body: '找不到证据的论断强制标"待验证"，不允许伪装成事实。赶工期时人也会把"我觉得"写成"数据显示"——把职业操守变成系统强制，报告质量不再依赖每个人每天的自律。' },
  { no: '2', name: 'AI 起草，人拍板', body: 'AI 无权写入任何正式记录，所有入账必须经人工审核。这不是技术不足，是刻意设计：大模型会幻觉，写诗无伤大雅，进决策依据是灾难。' },
  { no: '3', name: '账本只增不涂改', body: '追加式版本记录，如会计的红字冲销。组织记忆最大的敌人不是遗忘，而是无痕改写——事后大家对"当时为什么这么定"各执一词。' },
];

const results = [
  { label: '启动成本', value: '↓ 约 70%', body: '20 个部门的杂乱材料提纯：传统 3 人 × 2 周 → 系统处理 ＋ 我 1 人确认 × 2 天。' },
  { label: '汇报回炉率', value: '↓ 约 80%', body: '红队答辩前置，方案一次性通过，避免"被问倒 → 推倒重来 → 多部门拉扯一个月"。' },
  { label: '离职断档成本', value: '≈ 0', body: '接手同类项目从约 4 周（泡材料、对口径）→ 约 3 天（直接读决策账本的演化路径）。' },
];

const cardGrounds = [
  { no: '1.', text: '45 人高度复用，并入总部后因职能竖井将刚性索要 30 余个编制，编制不降反升。' },
  { no: '2.', text: '丧失高新资质与税收优惠，经济性显著下降。' },
  { no: '3.', text: '回购并表是中长期根本，设置双轨过渡可控。' },
];

const cases = (await getCollection('cases', (e: any) => !e.data.draft)).sort(
  (a: any, b: any) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="工作方法"
  active="method"
  description="我在真实咨询项目中构建并全程使用的判断与方案生产系统。"
>
  <article class="method">
    <!-- 第一段 · 开篇立论 -->
    <section class="wrap m-open">
      <p class="kicker">工作方法</p>
      <h1 class="display">决策账本</h1>
      <p class="m-sub">我在真实咨询项目中构建并全程使用的判断与方案生产系统</p>

      <blockquote class="m-quote">
        企业对钱的管理有账本——每笔支出有凭证、能审计。比钱更贵的重大决策，也应该有一本账。
      </blockquote>

      <p class="copy m-lede">
        这不是一个产品介绍——这是我的工作方法：让我经手的每个关键结论，都变成组织可积累、可追溯、可更新的系统资产。
      </p>

      <div class="m-reads">
        <p class="m-label">先读这两篇</p>
        <a class="m-read" href="/notes/judgment-never-capitalized/">
          <span class="rt">组织咨询的最大浪费：判断没有资产化</span>
          <span class="rk">为什么要建这套</span>
          <p class="rd">项目结项留下两三百页方案，推理过程、被否掉的备选、当时的权衡全部蒸发。这不是效率损失，是资产流失——前者让人想到再抓紧一点，后者才让人想到改记账方式。</p>
        </a>
        <a class="m-read" href="/method/cases/ai-workflow/">
          <span class="rt">AI 咨询工作流：这套工序在我自己手上怎么跑</span>
          <span class="rk">深读</span>
          <p class="rd">下面九道工序的逐步展开：每一步实际用什么、人工闸门卡在哪里、哪些环节反复失败过又改成了现在的样子。不是案例，是这套方法本身的操作说明。</p>
        </a>
      </div>

      <p class="m-source">
        源自 <b>22</b> 个部门 ＋ <b>5</b> 个子公司集团总部组织改革项目（我方负责 <b>11</b> 个部门 ＋ <b>3</b> 个子公司）。
      </p>
    </section>

    <section class="wrap m-block">
      <h2 class="m-h2">为什么围绕"判断"而不是"写材料"来建系统</h2>
      <p class="copy m-p">
        检索、归纳、写作、文书编制，正在变成大模型三十秒的廉价输出。真正稀缺的，搬到了 AI 能力终止的地方——在不确定中做出选择、并为之负责。<strong>这就是判断。</strong>
      </p>

      <p class="m-formula">判断 ＝ 预测 <i>×</i> 权衡 <i>×</i> 担责</p>

      <div class="m-grid3 sub3">
        {
          judgmentParts.map((j) => (
            <div class="cell">
              <span class="cname">{j.name}</span>
              <span class="cgloss">{j.gloss}</span>
              <span class="cverdict">{j.verdict}</span>
            </div>
          ))
        }
      </div>

      <p class="copy m-p">
        所以我让 AI 承包一切执行型脑力，把人的时间全部留给判断——<strong>这是整套系统唯一的设计原则。</strong>
      </p>
    </section>

    <!-- 第二段 · 为什么要建这套系统 -->
    <section class="wrap m-block">
      <h2 class="m-h2">这个项目开始时，我面对的是什么</h2>
      <div class="m-rows">
        {
          pains.map((p) => (
            <div class="row">
              <span class="rn">{p.no}</span>
              <span class="rname">{p.title}</span>
              <p class="rbody">{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="copy m-p"><strong>我的选择</strong>：不靠加班硬扛，而是把工作方法本身系统化——边做项目，边把这套系统建了出来。</p>
    </section>

    <section class="wrap m-block">
      <h2 class="m-h2">「决策账本」是什么</h2>
      <div class="m-def">
        <p class="dt">面向复杂项目的企业判断与方案生产系统。</p>
        <p class="dd">把分散的材料、专家经验和大模型能力组织成一条生产线，产出有依据、经得起质疑、能够持续更新的判断和解决方案。</p>
      </div>

      <p class="m-label">三个核心机制</p>
      <div class="m-grid3 sub2">
        {
          mechanisms.map((m) => (
            <div class="cell">
              <span class="cname">{m.name}</span>
              <div class="clist">
                {m.points.map((pt) => (
                  <p><span class="dot">·</span><span>{pt}</span></p>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="m-label">它不是</p>
      <div class="m-grid4">
        {
          notThese.map((n) => (
            <div class="cell">
              <span class="cname sm">{n.what}</span>
              <span class="cgloss">{n.why}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- 第三段 · 六个侧面 -->
    <section class="wrap m-block">
      <h2 class="m-h2">同一个系统的六个侧面（不是六个产品）</h2>
      <p class="copy m-p"><strong>一个目标</strong>：让复杂项目的每个关键结论，都有依据、经得起追问、能够持续更新。</p>
      <div class="m-grid3 sub2">
        {
          facets.map((f) => (
            <div class="cell">
              <span class="cnum-name">
                <span class="cnum">{f.no}</span>
                <span class="cname">{f.name}</span>
              </span>
              <p class="cbody">{f.body}</p>
            </div>
          ))
        }
      </div>
      <p class="copy m-p">六个侧面，指向同一个结果：把组织的判断力，变成<strong>可复制、可传承、可进化</strong>的核心资产。</p>
    </section>

    <!-- 第四段 · 九个环节 -->
    <section class="wrap m-block">
      <h2 class="m-h2">系统怎么工作：一条判断生产线</h2>
      <p class="copy m-p">从杂乱材料到组织判断资产：九个环节，不可跳步。</p>

      <div class="m-pipe">
        <div class="phead">
          <span>环节</span><span>名称</span><span>做什么</span><span>产出物</span>
        </div>
        {
          pipeline.map((p) => (
            <div class="prow">
              <span class="pno">{p.no}</span>
              <span class="pname">{p.name}</span>
              <span class="pwhat">{p.what}</span>
              <span class="pout">{p.out}</span>
            </div>
          ))
        }
      </div>

      <div class="m-out">
        <div>
          <p class="m-label">输出</p>
          <p class="obig">可防守的方案　＋　可传承的判断资产</p>
        </div>
        <p class="onote">每一步都有"质检闸门"与"留痕规则"，确保结果可信、可追溯、可传承。</p>
      </div>
    </section>

    <!-- 第五段 · 三条纪律 -->
    <section class="wrap m-block">
      <h2 class="m-h2">这套系统值钱，不在功能多，在三条纪律</h2>
      <div class="m-rows big">
        {
          disciplines.map((d) => (
            <div class="row">
              <span class="rn">{d.no}</span>
              <span class="rname">{d.name}</span>
              <p class="rbody">{d.body}</p>
            </div>
          ))
        }
      </div>
      <p class="m-punch">市面方案在赌"模型不出错"。我们不赌。</p>
      <div class="m-note-gold">
        <p>第三条同样用在我自己身上。<a href="/research/ledger/">公开判断记录</a>里的每一次改判都只追加、不删改——包括被自己的数据部分证伪的那一次。</p>
      </div>
    </section>

    <!-- 第六段 · 实测结果 -->
    <section class="wrap m-block">
      <h2 class="m-h2">这套方法在我负责的项目里，实测拿到的结果</h2>
      <p class="copy m-p">
        22 个总部部门 ＋ 5 个子公司的集团总部组织改革项目，我方负责 11 个部门 ＋ 3 家子公司——系统由我构建，并全程支撑材料入库、判断管理与方案生成。
      </p>

      <div class="m-grid3 sub3">
        {
          results.map((r) => (
            <div class="cell">
              <span class="cname sm">{r.label}</span>
              <span class="cstat">{r.value}</span>
              <span class="cgloss">{r.body}</span>
            </div>
          ))
        }
      </div>
      <p class="m-source">
        <strong>底层实测支撑</strong>：单份 3 小时访谈，稳定提取 21 条决策、35 条冲突，逐条可溯源；任一历史结论的依据，检索即得。
      </p>
    </section>

    <section class="wrap m-block">
      <h2 class="m-h2 sm">红队对话实录（脱敏）</h2>
      <p class="copy m-p">上会前我做这样的"问倒"十八次，逐一修补；最终方案一次性高票通过决策会。</p>

      <div class="m-red">
        <div>
          <p class="rlabel red">红队 · AI 扮演最挑剔的高层</p>
          <div class="rbox red">
            <p>股权被质押、工商重组受限，方案凭什么还把'全资回购'作为第一推荐？这不是画饼吗？</p>
          </div>
        </div>
        <div class="answer">
          <p class="rlabel">依据账本生成的应答</p>
          <div class="rbox gold">
            <p>回购是中长期根本，方案设置双轨过渡：工商解锁前按公允定价签服务协议；质押一解除，立即回购并表。</p>
            <p class="anchor">证据锚点 · 事实账本</p>
          </div>
        </div>
      </div>
      <p class="m-source">完整脱敏实录《星澜传媒重整项目》可深入交流。</p>
    </section>

    <section class="wrap m-block">
      <h2 class="m-h2 sm">它长什么样：一张判断卡</h2>
      <p class="copy m-p">判断卡就是一份人人能读的文档，写清押注、依据和认错条件。使用者无需任何技术背景。</p>

      <div class="m-card">
        <p class="cf">判断卡 · 星澜传媒何去何从</p>
        <div class="kv">
          <div class="k">当前押注</div>
          <div class="v"><strong>模式三：回购并表</strong></div>
          <div class="k">置信度</div>
          <div class="v">
            <span class="conf">
              <span class="val">0.70</span>
              <span class="bar"><i style="width:70%"></i></span>
            </span>
          </div>
          <div class="k">主要依据</div>
          <div class="v">
            <ul>
              {cardGrounds.map((g) => <li>{g.text}<span class="anchor">证据锚点 → 事实账本</span></li>)}
            </ul>
          </div>
          <div class="k">失效触发器</div>
          <div class="v"><span class="risk">股权质押半年内无法解除则改判模式一。</span></div>
        </div>
      </div>
      <p class="m-source">
        当前系统以文档账本 ＋ 后台引擎形态稳定运行，以上为真实工作形态示意；可视化操作界面为交付形态，随首批客户项目完成封装。
      </p>
      <p class="copy m-p last">这套系统是我为把项目做好而建的工具，不是我要出售的产品。</p>
    </section>

    <!-- 案例 -->
    <section class="wrap m-block">
      <h2 class="m-h2 sm">它在真实项目里跑过</h2>
      <div class="grid-2">
        {
          cases.map((c: any) => (
            <a class="case-card" href={`/method/cases/${c.data.slug}/`}>
              <p class="t">{c.data.title}</p>
              <dl>
                <div>
                  <dt>这篇讲什么</dt>
                  <dd>{c.data.summary}</dd>
                </div>
              </dl>
