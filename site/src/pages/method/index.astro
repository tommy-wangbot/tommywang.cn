---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JudgmentCard from '../../components/JudgmentCard.astro';
import NoteList from '../../components/NoteList.astro';
import type { JudgmentCardData } from '../../data/cards';

/**
 * 明鉴页正文中「一张判断卡长这样」的示例卡：
 * 取自案例的另一张真实卡（已脱敏），用于展示卡片版式本身。
 * 它不在首批公开账本的 7 张卡内，故不进 cards.json，只在本页内联。
 * 与账本重复的星澜「模式三」卡则共用 cards.json 的 CS-XINGLAN-01。
 */
const sampleCard: JudgmentCardData = {
  id: 'JUG-HX-20260624-13',
  kind: '案例',
  file: 'judgment_cards / JUG-HX-20260624-13',
  priority: 'high',
  title: '星澜传媒战略定位与版权采买生死线（三定前置阻断）',
  judgment:
    '押「定位与版权采买归属是 #0 问题」——它不属于三定范围，但不先由母公司定夺，治理判断（#1）与组织判断（#2）全部悬空；建议作为前置议题正式上报决策层，而非在三定内部消化。',
  confidence: 0.85,
  confidenceNote: '较上一版 0.70 上调 · 2026-06 访谈直证',
  weakest:
    '版权采买确实是该公司不可替代的命脉，而非可被母公司的内容资产管理部门平滑接管的一般职能。',
  counter:
    '母公司的内容资产管理部门已具备独立完成版权集采的能力与意愿；非版权业务已有可独立存续的现金流；母公司已明确愿意注入定位与资源。（2026-06 访谈核查：上述反证均未出现，反而出现强正证——受访方亲口「无版权则一大半业务可砍」。）',
  falsifier:
    '母公司正式出具定位意见、或版权采买归属作出明确决定——本卡即转入「定位已定」分支，重排 #1 / #2。',
  openedAt: '2026-06-24',
  reviewedAt: '2026-06-24',
  anchors: ['事实账本 · 该公司事实清单', '冲突编号 f19a3c72', '某次工作接触会纪要（已核）'],
};
---

<BaseLayout
  title="工作方法"
  active="method"
  description="一个人在复杂项目里摸索出的判断工作方法——如何把材料、经验和大模型能力，组织成一条可追溯、可验证、可持续演化的判断生产线。"
>
  <!-- 页首：主张 + 双翼定位 -->
  <section class="wrap section">
    <span class="kicker">一套判断的工作方法</span>
    <h1 class="h2">把杂乱信息，炼成可信的判断。</h1>
    <div class="prose" style="margin-top: var(--leading);">
      <p class="lead">让复杂项目的每个关键结论，都有依据、经得起追问、能够持续更新。</p>
      <p>
        这是我在复杂项目里摸索出的一套判断工作方法——让每个判断可追溯、可验证、可持续演化。这个站是我的工作笔记，记的是方法本身：不是宣传它能做什么，而是记录它长什么样、怎么运转、在真实项目里跑出过什么结果。
      </p>
      <blockquote>
        这套方法背后的理论推演——为什么「判断」会在 AI 时代变得比「知道」更稀缺——见
        <a href="/research/">研究与判断</a>。
      </blockquote>
    </div>
  </section>

  <!-- 名字就是说明书 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">这套方法要做的四件事</span>
    <div class="prose">
      <p>这套方法要做的，可以拆成四件事：</p>

      <p>
        <strong>明 · Transparency · 看得见的来路</strong><br />
        每条结论都能一路回看到原始材料的那一段话。不是「系统说的」，而是「出自哪份访谈的第几段」。→ 可追溯
      </p>
      <p>
        <strong>鉴 · Examination · 主动的审视</strong><br />
        鉴别、复核、交叉验证。检索不到依据就标「待验证」；定稿前先被最刁钻的追问打一遍。→ 可验证
      </p>
      <p>
        <strong>印 · Attestation · 鉴亦为凭，印信为据</strong><br />
        印鉴是古时的凭证。判断入册需人签核，账本追加式记录、旧版本不删——今天的凭据，就是三年后的说明书。→ 可问责
      </p>
      <p>
        <strong>照 · Scrutiny · 请您查证</strong><br />
        这句旧话正是我想要的姿态：把依据摊开，请您当场核。被追问不再是风险，而是最有准备的时刻。→ 经得起质询
      </p>

      <p>这套方法内部分四个部分运转，分别对应判断生产线的四道关口：</p>
      <ul>
        <li><strong>Research</strong>——研究与调研：材料入库、事实提纯、问题地图</li>
        <li><strong>Studio</strong>——方案生产：判断卡、红队答辩、答辩预案</li>
        <li><strong>Memory</strong>——组织记忆：判断模式库、经验的复利</li>
        <li><strong>Ledger</strong>——决策依据账本：追加式版本记录与证据锚点</li>
      </ul>
      <p>四个名字标示的是同一条判断生产线的四个部分，不是四个独立产品。</p>
    </div>
  </section>

  <!-- 五项隐性成本 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">这五项成本，不在预算表上，但一直在付</span>
    <div class="prose">
      <p>
        复杂项目里最贵的从来不是写报告的工时，而是判断没有账本时反复付出的代价。这是我在真实项目里反复撞见的五项隐性成本：
      </p>
      <p>
        <strong>01 · 材料整理压在人头上</strong><br />
        几十份杂乱材料的提纯，传统模式下要靠人力硬啃几周；项目还没开始判断，人力已经烧掉一轮。
      </p>
      <p>
        <strong>02 · 汇报被问倒，方案回炉</strong><br />
        台下一个问题现场答不上来，整个方案的可信度当场崩塌——「汇报被问倒 → 方案推倒重来 → 多部门重新拉扯」，往往以月计。
      </p>
      <p>
        <strong>03 · 依据找不回来</strong><br />
        半年后有人问「这条当初怎么定的」，只能翻纪要、打电话找已经不在这个项目里的人；为什么撤这个部门、谁提过反对意见，渐渐没人说得清。
      </p>
      <p>
        <strong>04 · 结论悄悄过期</strong><br />
        三周前的判断，建立在一个已经被新材料推翻的前提上，但没人记得这层依赖。人脑不擅长维护几百条结论之间的关系。
      </p>
      <p>
        <strong>05 · 经验随人蒸发</strong><br />
        核心成员一旦离开，他脑子里对业务、对组织、对「哪些诉求是真的」的手感一并带走；新人接手一个跑了半年的项目，常常要泡上数周材料才找到感觉。
      </p>
    </div>
  </section>

  <!-- AI 越强，判断越贵 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">AI 越强，判断越贵</span>
    <div class="prose">
      <p>
        AI 生成的选项越多、速度越快，「选哪个、为什么、谁负责」的决策压力就越大。执行力每扩容一次，判断力就升值一次。押注判断，是押注一条只涨不跌的曲线。
      </p>
      <p>
        这背后是一次稀缺性的搬家。<strong>第一站，信息稀缺的时代</strong
        >——懂外语、有资料、消息灵通就值钱，「知识就是力量」是字面意义的真理。<strong
          >第二站，互联网时代</strong
        >——信息免费了，稀缺变成注意力和「会搜索、会整合」的能力，善用信息的知识工人取代了「记得多」的旧文人。<strong
          >第三站，就是现在</strong
        >——检索、整合、分析变成聊天框里三十秒的免费输出，稀缺性再次向上游搬家，搬到了 AI
        能力终止的地方：在不确定中做出选择、并为之负责。
      </p>
      <p>
        判断，拆开看，等于预测 × 权衡 × 担责。<strong>预测</strong>（对局势的分析推演）AI
        可以做，甚至做得更好；<strong>权衡</strong
        >（在利润与风险、短期与长期之间说出「这个更重要」）需要立场和取舍，不存在于任何训练数据里；<strong
          >担责</strong
        >（用自己的位子、声誉为选择的后果买单）——AI
        没有可被问责的身份，删除一个模型不构成惩罚。它给出的建议本质上都是无担保的认知支票，而兑现支票的签名，必须由人来签。
      </p>
      <p>
        这背后其实是一次两百年一遇的对称。工业革命的本质不是发明了几台机器，而是把人类的体力变成了基础设施——蒸汽机和电力让「力气」从人身上剥离出来，变成随处可得的公共资源，靠出卖力气吃饭的劳动随之贬值，人转而去做机器做不了的事：控制机器、设计流程、组织生产。今天完全相同的过程正在认知领域重演——大模型正在把检索、归纳、翻译、写作、初步分析这类「执行型脑力」从人身上剥离出来，变成按
        token
        计价的公共资源。凡是能被写成流程、模板和规则的认知工作，成本正在不可逆地趋近于零；没被写进去的那部分——在不确定中做选择、并承担后果——正在变得更贵。
      </p>
    </div>
  </section>

  <!-- 一个母定义，三个机制 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">这套方法是什么：一个母定义，三个机制</span>
    <div class="prose">
      <p>
        这是我在复杂项目里摸索出的一套判断工作方法。它把分散的材料、专家经验和大模型能力组织成一条生产线，产出有依据、经得起质疑、能够持续更新的判断和解决方案。
      </p>
      <p>三个核心机制支撑这个定义——它们不是三个功能，而是同一条生产线上不可跳过的三道工序：</p>
      <p>
        <strong>决策依据账本</strong><br />
        每个重要结论记账入册，凭证（原始材料）可查；账本采用追加式版本记录——旧版本保留，修改通过新条目覆盖或标注失效，所有变更保留完整历史轨迹。
      </p>
      <p>
        <strong>证据驱动判断</strong><br />
        回答任何实质性问题、生成任何方案段落之前，先强制检索证据；检索不到依据的论断强制标注「待验证」，不允许伪装成事实混进报告。
      </p>
      <p>
        <strong>方案压力测试</strong><br />
        方案定稿前，先扮演「最刁钻的领导」从反方立场连环质疑；答不圆的地方回炉补证，并生成答辩预案——上会前先被问倒一次。
      </p>
      <p>
        它不是聊天机器人——是嵌入我工作流程的一条生产线，不是一个问答窗口；不是写作工具——写报告只是最后一道工序，且只允许基于通过检查的判断来写；不是网盘或知识库——知识库存放「名词」，它管理「判断」：活的、有置信度、会演化、能作废；也不取代我作为顾问该做的裁决——恰恰相反，它把我从翻材料、对口径、凭记忆答辩里解放出来，让我专注在只有我能做的那部分：拍板。
      </p>
    </div>
  </section>

  <!-- 九个环节 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">判断生产线：九个环节，不可跳步</span>
    <div class="prose">
      <p>
        原始材料进来，可被追问的判断出去。访谈录音、会议纪要、报表、制度文件、领导讲话——从原料到结论，每一步都有质检、有留痕、有责任人。
      </p>

      <p>
        <strong>01 原料提纯——杂料变净料，每条信息带出处</strong><br />
        录音、冗长文件、口水话纪要，先经过清洗和结构化——去噪、分类、拆条，并给每条信息标注来源。把一堆原始材料直接丢给大模型，等于让一位顶级律师直接翻你的杂物间——聪明是聪明，但案卷没整理，辩护词必然漏洞百出。先整理卷宗，再请律师出庭。<br />
        <em>我得到什么</em
        >：几十份杂乱材料在几天内变成一份「每条信息都有出处」的事实底稿。实测参考：单份 3
        小时访谈，稳定提取 21 条唯一决策、35 条唯一冲突，逐条可回溯原文段落。
      </p>
      <p>
        <strong>02 人工质检闸门——AI 起草，人批准，方可入账</strong><br />
        AI 提纯出的每一批内容——事实、决策、冲突——必须经我审核确认后，才能进入正式账本。AI
        无权直接写入任何正式记录。市面上的全自动方案在赌「模型不出错」；我不赌——进账本的每一个字都有人负责过。<br
        />
        <em>我得到什么</em>：一个可以放心引用的底座。调出的任何依据，都敢直接写进正式报告，因为它入库时被人确认过。
      </p>
      <p>
        <strong>03 决策依据账本——追加式版本记录的组织记忆</strong><br />
        所有经过确认的内容进入主账本，条目可以被后来的判断更新、标注失效、记录演化路径，旧版本始终保留——如同会计账目，更正靠红字冲销，而不是撕掉重写。<br
        />
        <em>我得到什么</em>：半年后有人问「这条当初怎么定的」，我打开账本，而不是打电话找已经不在项目里的人。
      </p>
      <p>
        <strong>04 双脑协同——夜班研究员消化，白班专家推理</strong><br />
        系统里有两个分工不同的 AI 脑：理解脑像夜班研究员，7×24
        小时在后台消化材料、维护索引，不做任何决策；生成脑像白班专家，处理具体任务时调取理解脑整理好的记忆做推理。让一个
        AI
        既管记忆又管推理，等于让一个人边整理档案室边出庭辩护——两头都做不好。分成两个脑，交互有契约：生成脑只能读账本、不能改写；理解脑只能起草入账、批准权在人。错误没有藏身之处的结构性原因就在这里。<br
        />
        <em>我得到什么</em>：一个「永远在岗」的研究团队。晚上丢进去三份访谈，第二天早上项目记忆已经更新完毕。
      </p>
      <p>
        <strong>05 证据强制——无依据，不进报告</strong><br />
        回答任何实质性问题、生成任何方案段落之前，强制先检索证据；每个关键结论必须挂上可以点回原文的依据。<br
        />
        <em>我得到什么</em>：被追问时的姿态从「容我回去查查」变成「您看，这是访谈原文」。实测参考：证据检索在自建评估集上
        Recall@5 = 1.00（前 5 条检索结果必含正确依据），索引覆盖近两百份材料。
      </p>
      <p>
        <strong>06 判断卡——把「拍脑袋」变成可检验的结构</strong><br />
        每个重要判断被写成一张标准结构的卡片，强制包含：结论是什么、支持它的证据、并行的其他解释、当前押哪个、置信度多少、这个判断最脆弱的假设是什么、出现什么信号就该认错改判。区分「专家」和「专业」的标志，不是结论多正确，而是是否预先声明了自己可能错在哪。<br
        />
        <em>我得到什么</em>：讨论不再是「我感觉」对撞「我认为」，而是两张摊开的判断卡：各自的证据、各自的脆弱点、各自的认错条件。只对高冲突、高风险的议题建卡，一张卡
        5–10 分钟。
      </p>
      <p>
        <strong>07 红队与答辩预演——上会前，先被问倒一次</strong><br />
        方案定稿前，扮演「最刁钻的领导」，基于账本里的全部材料从反方立场连环质疑：为什么这么定？依据充分吗？另一种方案为什么不行？同时生成答辩预案。所有做过重大汇报的人都懂那个噩梦——台下一个问题现场答不上来。让系统当第一个敌人，在没有代价的地方先失败一次，代价高的地方才能赢。<br
        />
        <em>我得到什么</em>：走进会议室之前，最坏的问题已经听过、答过、备好了弹药。
      </p>
      <p>
        <strong>08 变更重审——新材料进来，旧结论自动待检</strong><br />
        新增一份访谈、一组数据、一个表态后，识别它冲击了哪些既有判断，列出「受影响判断 →
        受影响方案段落」清单。复杂项目里最隐蔽的错误是「结论过期」——三周前的判断建立在一个已被新材料推翻的前提上，但没人记得这层依赖。<br
        />
        <em>我得到什么</em>：改方案不再是凭感觉「通读一遍看看哪里要动」，而是拿着一张精确的重审清单。
      </p>
      <p>
        <strong>09 规律沉淀——项目经验变成可复用的判断模式</strong><br />
        定期从积累的决策与冲突中提炼跨项目的规律——反复出现的风险模式、被验证有效的原则、特定组织的决策偏好——形成一份持续生长的判断模式库。每条模式都带着适用条件、已知反例、失效条件、最近一次验证时间。这不是绝对真理的清单，而是带条件、可作废的经验规则集。<br
        />
        <em>我得到什么</em>：经验第一次有了复利。第 10 个项目不是第 1 个项目的重复，而是站在前 9
        个项目的全部判断之上。
      </p>
    </div>
  </section>

  <!-- 一张判断卡长这样 -->
  <section class="dark">
    <div class="wrap section">
      <span class="kicker">一张判断卡，长这样</span>
      <h2 class="h2">判断卡强制分开三样东西：事实、观点、判断。</h2>
      <p class="copy" style="margin-top: var(--leading);">
        判断卡强制分开三样通常混在一起的东西：事实（可核对）、观点（谁主张）、判断（基于什么押注）。以下是一张真实案例中的卡片节选（已脱敏）。
      </p>
      <div style="margin-top: calc(1.6 * var(--leading));">
