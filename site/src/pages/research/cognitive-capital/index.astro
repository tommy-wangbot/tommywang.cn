---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import JudgmentCard from '../../../components/JudgmentCard.astro';
import { getCollection } from 'astro:content';
import { getCards } from '../../../data/cards';

const axioms = [
  {
    id: 'AX-001',
    name: '公理一：稀缺性公理',
    one: '经济价值只居于稀缺处；技术革命不消灭稀缺性，只搬迁稀缺性——每一次搬迁都伴随一次财富与权力的重新洗牌。',
    expand:
      '过去两百年，认知领域的稀缺性完成了两次迁徙——先从「信息占有」搬到「注意力与检索整合」，如今第三次迁徙正在发生：知识与技能被 AI 压至耗材价格，稀缺性正搬往 AI 能力光谱终止的地方——在不确定性中做出选择并承担后果的能力。稀缺性从未消失，只是换了地址。',
    falsifier:
      '若判断本身被证明可以被完整复制、免费供给——也就是说，判断里「排序」与「承诺」这两个分量也能被 AI 稳定复现，而不只是模仿其表面输出——稀缺性就不再有下一个搬迁地址，而是被真正消灭，公理一「只搬迁、不消灭」的论断随之动摇。【待审：这一情形与公理三高度相关，一旦责任可以由非肉身实体承担，两条公理可能同时失效】',
  },
  {
    id: 'AX-002',
    name: '公理二：执行通缩公理',
    one: '凡是可被完整符号化的认知过程，其执行成本必然趋近于零；且符号化的边界随模型能力扩张而单调外推——今天不可符号化的，明天未必。',
    expand:
      '这条公理自带一条开放边界——它承认自己的适用范围会持续扩张。执行力的边际成本归零，是「努力—回报」这份旧契约失效的直接原因：当一个模型能在三十秒内完成过去需要数天的分析工作，一切以「我能执行」为定价基础的劳动都在系统性贬值，与个人是否努力无关。',
    falsifier:
      '若符号化的边界最终扩张到吞噬「判断」本身——即 AI 被证明能够完整复现判断中的排序与承诺分量，而不只是模仿其输出结果——公理二默认划定的「通缩止于判断」这条防线就会被突破，届时公理二与公理三之间的分界需要重新划定。【待审】',
  },
  {
    id: 'AX-003',
    name: '公理三：责任肉身公理',
    one: '不确定性下的选择责任无法转移给不具备「可剥夺命运」的实体；只要人类社会仍以问责为协作基础，责任的终点必然是一个肉身节点。',
    expand:
      'AI 能穷尽已知路径，却没有可供剥夺的命运——删除一个模型不构成惩罚，因此它给出的只是一张无担保的认知支票。社会的全部问责结构——合同法、公司法、刑法——都需要一个可被追索的肉身节点作为终点，这也是「判断」能够索取剩余、成为资本的底层原因。',
    falsifier:
      '书稿正文明确给出的例子——若 AI 获得了可被法律追索的人格，也就是出现了一个可被剥夺「命运」、可被真正问责的非肉身责任主体，问责链条的终点将不再必然指向人类个体，公理三随之需要修正。',
  },
];

const cards = Object.fromEntries(
  getCards('AX-001', 'AX-002', 'AX-003').map((c) => [c.id, c])
);

const parts = [
  {
    t: '第一部：公理与法则——新生产函数的诞生',
    d: '彻底证伪「投入劳动时间与报酬大体成正比」这份旧契约，立起一套新的价值生产公式：价值由认知资本与 AI 能力的乘数组合决定，再经分配位置与制度环境两道闸门过滤。这一部还要解剖算力与专有数据如何构成新时代的「认知地租」基础设施——判断力的稀缺，是建立在一块极其昂贵的物质地基之上的。',
  },
  {
    t: '第二部：核心转移——判断资本主义的诞生',
    d: '详细论证为什么「判断」能够跨越单纯的个人技能，满足资本的全部社会学定义：对生产过程的排他性支配、剩余索取权、自我增殖能力、对价值实现过程的终极控制。并剖析「判断阶层」与「算法规训阶层」这两个新阶层的社会学画像，以及分化为何会越拉越大。',
  },
  {
    t: '第三部：系统重置——认知政治经济学的核心冲突',
    d: '当判断成为统治性资本，权力（从统治到架构）、分配（认知税与全民基本收入的博弈）、组织（从科层到「判断核+执行云」）与社会契约（劳动锚定的失效与重建）会依次发生怎样的系统性冲突。这是全书最贴近现实政策讨论的一部。',
  },
  {
    t: '第四部：智能的本体论与认知战场的重构',
    d: '把镜头从宏观拉回每一个人的颅腔之内：人脑与机器智能在结构上究竟是什么关系，大脑在长程反馈与走神中的不可替代性来自哪里；以及「合成现实」如何推高社会的共识成本，教育体系失灵后可能出现的更深险境——以神经发育为传承介质的「认知世袭」。',
  },
  {
    t: '第五部：终极发问——人类价值的最后锚点',
    d: '把论述推向全书的哲学终局：如果连高阶判断最终也被机器接管，人类如何安放自己的价值？这一部讨论「效用人」的死亡，以及依靠主观体验与死亡意识重新建构人类作为意义赋予者的终极位置。',
  },
];

const excerpts = (await getCollection('excerpts', (e: any) => !e.data.draft)).sort(
  (a: any, b: any) => a.data.order - b.data.order
);
---

<BaseLayout
  title="认知资本论"
  active="research"
  description="一套关于 AI 时代新生产关系与人类价值重置的理论推演——一本边写边公开的书。"
>
  <section class="wrap section">
    <span class="kicker">研究与判断 · 旗舰研究</span>
    <h1 class="h2">认知资本论</h1>
    <div class="prose" style="margin-top: var(--leading);">
      <h2 class="h3" style="margin-top: 0;">这是一本正在写的书，边写边公开</h2>
      <p>
        《认知资本论：AI 时代的新生产关系与人类价值重置》是一本正在写的书，约四万字，尚未出版。它想回答一个问题：<strong
          >当知道和执行的成本被 AI 压到接近于零，人类还剩下什么东西是真正稀缺、值得押注的？</strong
        >
      </p>
      <p>
        这一页是它的骨架——三条公理、五部脉络。<strong>手稿本身也放在这里，公开地写</strong>：按「部」
        分批挂出，每一部标着写作状态和最后改动的日期，标成「在写」的地方就是我自己还没想清楚的地方。
        这么做不是为了展示进度，而是因为这本书论证的东西——判断要敢于标出自己的失效条件——
        写作过程本身也该照做。
      </p>
      <p><a href="/research/cognitive-capital/manuscript/">读手稿 →</a></p>
    </div>
  </section>

  <section class="dark">
    <div class="wrap section">
      <span class="kicker">三条公理，三张卡</span>
      <h2 class="h2">置信度、失效条件、复核日期，逐张真实标注。</h2>
      <p class="copy" style="margin-top: var(--leading);">
        全书的每一个论断，最终都能回溯到这三块基石。三条公理各司其职：公理一决定价值往哪里流动，公理二决定哪些能力注定贬值，公理三决定哪种能力构成价值的刚性底座。它们不是不可推翻的信条，而是随时可被现实校验的赌注——这正是下面每张卡片都留着「失效条件」和「置信度」两个空位的原因。
      </p>

      {
        axioms.map((a) => (
          <div style="margin-top: calc(2 * var(--leading));">
            <h3 class="h3">{a.name}</h3>
            <p class="lead" style="margin-top: var(--half);">{a.one}</p>
            <p class="copy" style="margin-top: var(--leading);">{a.expand}</p>
            <p class="copy" style="margin-top: var(--leading);">
              <b>失效条件（书稿表述）：</b>
              {a.falsifier}
            </p>
            <p class="copy" style="margin-top: var(--half);">
              <b>置信度：</b>【待审】
            </p>
            <div style="margin-top: calc(1.4 * var(--leading));">
              <JudgmentCard card={cards[a.id]} />
            </div>
          </div>
        ))
      }

      <p class="copy" style="margin-top: calc(1.6 * var(--leading));">
        三张卡同时挂在 <a href="/research/ledger/">公开判断账本</a> 上——那里把书稿的失效条件重写成了可观察的信号。
      </p>
    </div>
  </section>

  <section class="wrap section">
    <span class="kicker">全书的脉络：五部</span>
    <h2 class="h2">不是一份职场提效指南，是一次对认知时代权力运作逻辑的系统推演。</h2>
    <div class="prose" style="margin-top: var(--leading);">
      <p>五部逻辑层层递进：</p>
      {
        parts.map((p) => (
          <p>
            <strong>{p.t}</strong>
            <br />
            {p.d}
          </p>
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">两篇试读</span>
    <h2 class="h2">从书稿里摘出来的两段，经编辑以便独立读完。</h2>
    <p class="copy" style="margin-top: var(--leading);">
      不想从头读的话，可以先看这两篇——它们各自完整。要整部读，去
      <a href="/research/cognitive-capital/manuscript/">手稿</a>。
    </p>
    <div class="grid-2">
      {
        excerpts.map((e: any) => (
          <a class="tile" href={`/research/cognitive-capital/${e.data.slug}/`}>
            <p class="t">{e.data.title}</p>
            <p>选自《{e.data.source}》，经编辑以便独立阅读。</p>
            <span class="go">读试读 →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <p class="copy">
      这些判断最终要在真实项目里接受检验——那部分记录在 <a href="/mingjian/">工作方法</a>。
    </p>
    <p style="margin-top: var(--leading);"><a class="back" href="/research/">返回研究与判断</a></p>
  </section>
</BaseLayout>
