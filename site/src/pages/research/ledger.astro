---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JudgmentCard from '../../components/JudgmentCard.astro';
import { CARDS } from '../../data/cards';
import { QUESTIONS, HYPOTHESES } from '../../data/ledger';
---

<BaseLayout
  title="公开判断账本"
  active="research"
  description="提前公开、带失效条件、可被打脸的判断。问题 → 假设 → 判断，状态迁移公开可见。"
>
  <section class="wrap section">
    <span class="kicker">研究与判断 · 判断账本</span>
    <h1 class="h2">提前公开，带失效条件，对错由时间裁决。</h1>
    <p class="copy" style="margin-top: var(--leading);">
      这一页记的是我自己的判断账。账上的东西分三类：<b>问题</b>——我还没有答案，一行即可；<b>假设</b>——有初步解释，但证据不充分，只写短段落并交代当前证据状态；<b>判断</b>——我愿意据此行动、据此配置的结论，上完整卡片。
    </p>
    <p class="copy" style="margin-top: var(--leading);">
      两条铁律：<b>写不出失效条件的命题不上卡</b>；<b>每季度半小时全卡复核，更新复核日期，改判只追加、不删改。</b>问题 → 假设 → 判断的状态迁移，就是这一页的生命——它把「原始材料进来、可被追问的判断出去」这条生产线，在我自己身上公开演一遍。
    </p>
    <p class="copy" style="margin-top: var(--leading);">
      首批完整卡 {CARDS.length} 张，宁缺毋滥。置信度一栏目前统一带【待审】标记，是我还没有逐张定稿的诚实记号，不是排版遗漏。
    </p>
  </section>

  <!-- 问题层 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">问题 · 我还没有答案</span>
    <h2 class="h3">账本上不是每一格都有结论。</h2>
    <div class="layer">
      {
        QUESTIONS.map((q) => (
          <div class="layer-item" id={`q-${q.id}`}>
            <p class="q">{q.question}</p>
            <p class="copy">{q.note}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 假设层 -->
  <section class="wrap section" style="border-top: 2px solid var(--divider);">
    <span class="kicker">假设 · 有初步解释，证据不充分</span>
    <h2 class="h3">这一层写明：我为什么还不敢把它写成判断。</h2>
    {
      HYPOTHESES.map((h) => (
        <div class="hypo" id={`card-${h.id}`}>
          <p class="hfile">{h.file} · kind: 假设 · status: 待定稿</p>
          <p class="q">{h.proposition}</p>

          <p class="hl">当前证据状态</p>
          <p class="copy">
            <b>支持这一读法的：</b>
            {h.support}
          </p>
          <p class="copy">
            <b>反证（来自我自己的项目样本）：</b>
            {h.counter}
          </p>
          <p class="copy">
            <b>结论：</b>
            {h.conclusion}
          </p>

          <p class="hl">升级为判断需要看到</p>
          <ul class="copy hlist">
            {h.upgrade.map((u) => (
              <li>{u}</li>
            ))}
          </ul>

          <p class="hl">降级或放弃需要看到</p>
          <ul class="copy hlist">
            {h.downgrade.map((d) => (
              <li>{d}</li>
            ))}
          </ul>

          <p class="hmeta">
            置信度 {h.confidence} · 入账 {h.openedAt} · 最近复核 {h.reviewedAt}
          </p>
        </div>
      ))
    }
  </section>

  <!-- 判断层 -->
  <section class="dark">
    <div class="wrap section">
      <span class="kicker">判断 · 完整卡片</span>
      <h2 class="h2">押注、置信度、失效条件、日期，一项都不能少。</h2>
      <div style="margin-top: calc(1.6 * var(--leading));">
        {CARDS.map((c) => <JudgmentCard card={c} />)}
      </div>
      <p class="disclaimer">以上为个人研究记录。涉及投资方向的卡片，均不构成投资建议。</p>
    </div>
  </section>

  <section class="wrap section">
    <p><a class="back" href="/research/">返回研究与判断</a></p>
  </section>
</BaseLayout>
