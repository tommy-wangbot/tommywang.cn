---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusTag from '../../components/StatusTag.astro';
import CardPair from '../../components/CardPair.astro';
import { SITE } from '../../data/site';
import { fmtDate, cardIdsOf, cardTitle } from '../../lib/notes';
import { LEDGER_CARDS } from '../../data/cards';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note: any) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const ids = cardIdsOf(note.data);
const publicIds = ids.filter((id) => LEDGER_CARDS.some((card) => card.id === id));
const carded = ids.length > 0;
const publicCard = publicIds.length > 0;
const isHypo = note.data.status === '假设';
---

<BaseLayout
  active="notes"
  title={note.data.title}
  description={note.data.excerpt ?? SITE.tagline}
>
  <article class="wrap-narrow note">
    <div class="nmeta">
      <StatusTag status={note.data.status} cardIds={ids} />
      <span class="nd">
        {fmtDate(note.data.date)} · {carded ? `${isHypo ? '已立卡 · 待验证' : '配对卡'} ${ids.join('、')}` : '未立卡'}
      </span>
    </div>

    <h1 class="nh1">{note.data.title}</h1>

    {
      note.data.status === '假设' && (
        <div class="nhypo">
          <p>
            {carded ? (
              <>先把话说在前面：<strong>这一篇已立判断卡，仍待验证。</strong>我已把核心假设、竞争解释、反证条件和验证办法写进卡片。立卡是开始跟踪和检验，不代表组织层面的效果已经得到证明。</>
            ) : (
              <>先把话说在前面：<strong>这一篇是假设，不是判断。</strong>它有一个我觉得挺有解释力的机制，但支持它的证据还不足以让我据此行动，所以它现在只能停在假设层，不上判断卡。</>
            )}
          </p>
        </div>
      )
    }

    <div class="prose">
      <CardPair ids={ids} />
      <Content />
    </div>

    <div class="nfoot">
      <p class="fl">这篇文章的账本状态</p>
      {
        publicCard ? (
          publicIds.length === 1 ? (
            <p class="ft">
              这条判断已经入账，可在 <a href={`/research/ledger/#card-${publicIds[0]}`}>公开判断记录</a> 上看到它的置信度、失效条件与复核历史。改判只追加，不删改。
            </p>
          ) : (
            <p class="ft">
              这一篇的论断已分成 {publicIds.length} 条判断入账，都可在 <a href="/research/ledger/">公开判断记录</a> 上查看置信度、失效条件与复核历史：
            </p>
          )
        ) : carded ? (
          <p class="ft">
            这篇文章已建立判断卡 {ids.join('、')}，目前为草稿、待验证。卡片记录了竞争解释、反证条件与首轮验证办法，完整卡片暂未公开。立卡不等于证据已经充分。
          </p>
        ) : (
          <p class="ft">
            这一篇还没有立卡。升级为判断时会在 <a href="/research/ledger/">公开判断记录</a> 上立卡，本页顶部的状态标签同步更新；放弃也记一笔，不删本页。
          </p>
        )
      }
      {
        publicIds.length > 1 && (
          <ul class="fcl">
            {publicIds.map((id) => (
              <li>
                <a href={`/research/ledger/#card-${id}`}>{cardTitle(id) ?? id}</a>
                <span class="fcid">{id}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <p class="nback"><a class="back" href="/notes/">返回笔记</a></p>
  </article>
</BaseLayout>

<style>
  .note { padding-block: calc(2 * var(--leading)) calc(2.4 * var(--leading)); }
  .nmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .nmeta .nd { font-family: var(--font-mono); font-size: 12.5px; color: var(--ink-55); }
  .nh1 {
    margin: 24px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.32;
    letter-spacing: 0.01em;
    max-width: 22em;
  }
  .nhypo { margin-top: 32px; border-left: 3px solid var(--gold); padding: 2px 0 2px 22px; }
  .nhypo p { margin: 0; font-size: 16.5px; line-height: 1.95; color: var(--ink-70); }
  .nhypo strong { color: var(--ink); }
  .note .prose { margin-top: calc(1.4 * var(--leading)); }
  .nfoot { margin-top: calc(1.8 * var(--leading)); padding-top: calc(1.2 * var(--leading)); border-top: 2px solid var(--ink); }
  .nfoot .fl { margin: 0 0 12px; font-family: var(--font-heading); font-size: 12px; font-weight: 600; letter-spacing: 0.16em; color: var(--ink-55); }
  .nfoot .ft { margin: 0; font-size: 15.5px; line-height: 1.9; color: var(--ink-70); max-width: 46em; }
  /* 一篇挂多张卡时，逐条列出卡标题与卡号 */
  .nfoot .fcl { list-style: none; margin: 14px 0 0; padding: 0; }
  .nfoot .fcl li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 10px 0; border-bottom: 1px solid var(--divider); }
  .nfoot .fcl a { font-size: 15.5px; }
  .nfoot .fcl .fcid { font-family: var(--font-mono); font-size: 12px; color: var(--ink-55); }
  .nback { margin: calc(1.4 * var(--leading)) 0 0; }
</style>
